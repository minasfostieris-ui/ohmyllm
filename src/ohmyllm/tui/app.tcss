/* OhMyLLM theme.
   Rules of the house (user mandate, final form):
   - Frames are THIN box-drawing glyph borders: ─ │ ┌ ┐ └ ┘ (Textual's
     "solid" style). The painted padding rings read as chunky blocks and
     the user ordered every one replaced with lines.
   - No alpha washes on colors; solid theme variables only:
     $ring (frame/accent), $ring-text (dark text on $ring), $tint
     (solid dark accent fill), plus Textual's $surface/$panel/$boost.
     (NO_COLOR used to grey everything — app.py overrides that.)
   - Band children use width: 1fr (100% over-resolves and paints over
     the band's right border — proven in the user's terminal).
   - Textual 8.2.8 renders scrollbar thumbs from the CONTAINER's
     scrollbar-* styles, so they live on the container selectors. */

Screen { background: $surface; scrollbar-size: 0 0; }

#mode-banner {
    height: auto;
    display: none;
    padding: 0 1;
}

#status-bar {
    height: 1;
    background: $boost;
    color: $text;
    padding: 0 2;
}

/* ---------- scrollbars: solid cyan thumb, dark track, continuous ---------- */
/* ScrollBarRender's fractional head/tail glyphs are blanked at runtime
   (app.py _patch_scrollbar_glyphs), so the thumb is pure background
   cells — straight in every font. */
VerticalScroll, DataTable, OptionList, TextArea, ScrollView, Log {
    scrollbar-size: 1 1;
    scrollbar-color: $ring;
    scrollbar-color-hover: $ring;
    scrollbar-color-active: $ring;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-corner-color: $surface;
}

/* ---------- chat ---------- */
#chat-root { width: 100%; height: 1fr; }
#chat-left { width: 1fr; height: 100%; overflow: hidden; }

.turn-stats { color: $text-muted; padding: 0 2 1 2; }
#chats-filters { height: 3; }
#chats-filters Input { width: 1fr; min-width: 20; }
#chats-preview { height: 9; }

.msg-think { color: $text-muted; padding: 0 0 1 0; }
.msg-user { color: $text; padding: 0 0 1 0; }
.msg-assistant { padding: 0 0 1 0; }
.msg-system { color: $warning; padding: 0 0 1 0; }
.msg-error { color: $error; padding: 0 0 1 0; }

#panel-sep {
    width: 1;
    height: 1fr;
    display: none;
}
#tool-panel {
    width: 42;
    height: 1fr;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    overflow: hidden;
}

/* the ask-anything box: thin solid-cyan ┌─┐ frame with a 1-cell margin so
   it never touches the screen edge; flow layout (no dock) so the status
   bar can never overdraw its bottom border */
#chat-input-band { height: auto; background: transparent; border: none; padding: 0; }
#chat-input { border: solid $ring; margin: 0 1; background: $surface; color: $text; }

/* ---------- generic screens ---------- */
#chat-title { height: 1; padding: 0 2; color: $accent; }
#screen-title { height: 1; padding: 0 2; color: $accent; text-style: bold; }
.detail-box {
    height: auto; max-height: 38%; padding: 0 1; color: $text-muted;
    overflow-y: auto; border: solid $ring;
}
#models-band { height: 1fr; width: 100%; }
/* .band = thin solid-cyan box frame: ┌ ─ ┐ │ └ ┘ */
.band { border: solid $ring; background: transparent; padding: 0; height: auto; overflow: hidden; }
DataTable { height: 1fr; width: 1fr; background: $surface; }
#chats-table { margin: 0 0 0 1; border: solid $ring; }
/* Textual paints its scrollbar one cell INSIDE the widget, adjacent to any
   border — the thumb column and the border column never coincide, which
   reads as a zig-zag. Where a box already has a solid right border, the
   built-in scrollbar is hidden; the single │ line is the edge. */
#models-table, #chats-table, #chats-preview, .detail-box, #soul-area, #slash-menu {
    scrollbar-size: 0 0;
}
DataTable > .datatable--header { background: $tint; color: $text; }
DataTable > .datatable--cursor { background: $ring; color: $ring-text; }
DataTable > .datatable--hover { background: $tint; }

.screen-body { height: 1fr; }

/* ---------- modals ---------- */
/* every modal screen centers its card; every card hugs its content */
#prompt-modal, #confirm-modal, #approval-modal, #info-modal, #key-modal-screen {
    align: center middle;
}

.band-warning { border: solid $warning; background: transparent; max-width: 112; }
#approval-box {
    width: 1fr;
    height: auto;
    max-height: 88%;
    overflow-y: auto;
    background: $surface;
    padding: 1 2;
}

#prompt-box {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 1 2;
}

#confirm-box {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 1 2;
}

#key-modal {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 1 2;
}
#prompt-buttons, #confirm-buttons, #approval-buttons, #key-buttons {
    height: auto; align-horizontal: right; padding-top: 1;
}
#prompt-label, #confirm-q { width: 100%; }
.modal-hint { color: $text-muted; margin-bottom: 1; }
.modal-buttons { height: auto; align-horizontal: right; padding-top: 1; }

.band-danger { border: solid $error; background: transparent; }

.code-block { height: auto; max-height: 30%; background: $surface; padding: 0 1; }
.preview-block { max-height: 45%; }

/* ---------- model settings modal ---------- */
#model-settings-modal {
    align: center middle;
}
#ms-band { width: 100; max-width: 92%; height: 92%; }
#model-settings-box {
    width: 1fr; height: 100%;
    background: $surface; padding: 1 2;
}
#ms-scroll { height: 1fr; }
.ms-title { margin-bottom: 1; }
.ms-row { height: auto; }
.ms-field { width: 1fr; height: auto; margin-right: 2; }
.ms-field:last-child { margin-right: 0; }
#ms-buttons { height: auto; align-horizontal: right; padding-top: 1; }

/* ---------- settings ---------- */
/* ---------- settings: OMP-style tab bar + flat key/value rows ---------- */
#settings-body { padding: 0 2 1 2; }
#settings-tabs { height: 2; width: 100%; margin-bottom: 1; }
#settings-actions { height: auto; margin-top: 1; }
.st-tab { height: 2; min-width: 0; padding: 0 1; margin: 0 1 0 0; background: transparent; color: $text-muted; border: none; text-style: bold; }
.st-tab:hover { color: $text; }
.st-tab.-active { background: $ring; color: $ring-text; }
.st-page { display: none; width: 100%; height: auto; }
.st-page.-show { display: block; }
.st-row2 { height: 1; width: 100%; margin-bottom: 1; }
.st-k { width: 36; color: $text; }
.st-inline-hint { color: $text-muted; }
.st-desc { color: $text-muted; margin-bottom: 1; }
#st-desc-focused { height: 1; color: $text-muted; margin-top: 1; }
#st-theme-list { height: 8; width: 1fr; margin-bottom: 1; }

/* ---------- wizard ---------- */
#wizard-body { height: 1fr; padding: 1 2; }
#wizard-buttons { height: auto; align-horizontal: right; padding: 1 2; }
#wizard-progress { height: 1; color: $success; }

/* ---------- help ---------- */
HelpMarkdown { padding: 1 3; }

/* ---------- memory ---------- */
#soul-area { height: 1fr; width: 1fr; background: $surface; }
#memory-buttons { height: auto; }
#recent-memory { height: 8; color: $text-muted; background: $surface; padding: 1 2; }

/* ---------- inputs & chips: painted, no glyph frames ---------- */
Input { margin: 0 1; border: none; background: $surface; color: $text; }
Input:focus { background: $boost; }
#chat-input:focus { border: solid $ring; background: $surface; }

OptionList { border: none; background: $surface; }
OptionList > .option-list--option-highlighted { background: $tint; }
OptionList > .option-list--option-hover { background: $tint; }

TextArea { border: none; }

Tooltip { border: none; background: $boost; color: $text; }

CommandPalette { width: 70%; min-width: 50; height: 60%; min-height: 10; border: solid $ring; background: $surface; padding: 1; }
CommandPalette > * { background: $surface; }

/* perms: whole screen scrolls so the detail box never clips at 34 rows */
PermsScreen { overflow-y: auto; }
#mode-list { height: auto; max-height: 10; }
.perm-row { height: 1; margin-top: 1; }

/* ---------- slash command menu ---------- */
#slash-band { display: none; margin: 0 2; }
#slash-menu {
    height: auto;
    max-height: 10;
    background: $surface;
    scrollbar-size: 0 0;
}

/* markdown furniture: painted, never glyph bars */
MarkdownBlockQuote > BlockQuote { border-left: solid $ring; background: transparent; padding: 0 1; }
Collapsible { border-top: solid $ring; margin-top: 1; }
.msg-file { padding: 0 0 0 2; }
.msg-file-live { padding: 0 2 1 2; }

/* ---------- backend screen cards ---------- */
.backend-card { height: auto; padding: 0 1 1 1; }
.card-buttons { height: auto; }

/* ---------- switches: painted track, no glyph frame ---------- */
Switch { border: none; background: $panel; padding: 0 1; margin-right: 1; }
Switch > .switch--slider { color: $text; }
Switch.-on { background: $tint; }
Switch.-on > .switch--slider { color: $ring; }
Switch:focus { background: $ring; }
Switch:focus > .switch--slider { color: $ring-text; }

/* Buttons ship a `border: tall` glyph frame — dashed in the user's
   terminal. Painted chip instead: solid background, no glyphs. */
Button { border: none; background: $boost; color: $text; text-style: bold; padding: 1 2; margin: 0 1; }
Button:hover { background: $tint; }
Button:focus { background: $ring; color: $ring-text; }
Button.-primary { background: $ring; color: $ring-text; }
Button.-primary:hover { background: $secondary; color: $ring-text; }
Button.-error { background: $error; color: $text; }
Button.-error:hover { background: $warning; color: $ring-text; }
/* success/warning variants (approval modal) — app CSS outranks the widget
   defaults, so they must be styled here or they render as plain chips */
Button.-success { background: $success; color: #04240f; }
Button.-success:hover { text-style: bold underline; }
Button.-warning { background: $warning; color: #2b1d02; }
Button.-warning:hover { text-style: bold underline; }
