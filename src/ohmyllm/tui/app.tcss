/* OhMyLLM theme */

$primary: #00e5ff;
$secondary: #00b8d4;

Screen { background: $surface; }

#mode-banner {
    height: auto;
    display: none;
    padding: 0 1;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $boost;
    color: $text;
    padding: 0 2;
}

/* ---------- chat ---------- */
#chat-root { width: 100%; height: 1fr; }
Screen { scrollbar-size: 0 0; }
/* Textual 9 paints scrollbars inside the scroll container itself (no
   ScrollBar child widget), so the scrollbar-* styles must sit on the
   containers, not a `ScrollBar` selector. */
VerticalScroll, DataTable, OptionList, TextArea, ScrollView, Log {
    scrollbar-size: 0 0;
    scrollbar-color: transparent $surface;
    scrollbar-color-hover: transparent $surface;
    scrollbar-color-active: transparent $surface;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-corner-color: $surface;
}

#chat-left { width: 1fr; height: 100%; overflow: hidden; }

.turn-stats { color: $text-muted; padding: 0 2 1 2; }
#chats-filters { height: 3; }
#chats-filters Input { width: 1fr; min-width: 20; }
#chats-preview { height: 9; }

.msg-think { color: $text-muted; padding: 0 0 1 0; }
.msg-user { color: $text; padding: 0 0 1 0; }
.msg-assistant { padding: 0 0 1 0; }
.msg-system { color: $warning; padding: 0 0 1 0; }
.msg-error { color: $error; padding: 0 0 1 0; }

#panel-sep {
    width: 1;
    height: 1fr;
    display: none;
}
#tool-panel {
    width: 42;
    height: 1fr;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    overflow: hidden;
}

#chat-input { dock: bottom; }
#chat-input { border: solid #00e5ff; }
#chat-input:focus { border: solid #00e5ff; background: $primary 30%; }

/* ---------- generic screens ---------- */
#screen-title { height: 1; padding: 0 2; color: $accent; text-style: bold; }
.detail-box {
    height: auto; max-height: 38%; padding: 0 1; color: $text-muted;
    overflow-y: auto; scrollbar-size: 1 2; scrollbar-color: $accent $surface;
}

/* .band = painted ring: the container's background shows through its
   1-cell padding — a continuous solid frame with ZERO font dependency
   (borders/outlines are always glyphs; glyphs break in some terminals). */
.band { background: $primary 60%; padding: 1; height: auto; overflow: hidden; }
#models-band { height: 1fr; }
DataTable { height: 1fr; width: 1fr; background: $surface; scrollbar-size: 0 0; }

.screen-body { height: 1fr; }

/* ---------- modals ---------- */
/* every modal screen centers its card; every card hugs its content */
#prompt-modal, #confirm-modal, #approval-modal, #info-modal, #key-modal-screen {
    align: center middle;
}

.band-warning { background: $warning 60%; max-width: 112; }
#approval-box {
    width: 1fr;
    height: auto;
    max-height: 88%;
    overflow-y: auto;
    background: $surface;
    padding: 1 2;
}

#prompt-box {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 1 2;
}

#confirm-box {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 1 2;
}

#key-modal {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 1 2;
}
#prompt-buttons, #confirm-buttons, #approval-buttons, #key-buttons {
    height: auto; align-horizontal: right; padding-top: 1;
}
#prompt-label, #confirm-q { width: 100%; }
.modal-hint { color: $text-muted; margin-bottom: 1; }
.modal-buttons { height: auto; align-horizontal: right; padding-top: 1; }

.band-danger { background: $error 60%; }

.code-block { height: auto; max-height: 30%; background: $primary 25%; padding: 0 1; }
.preview-block { max-height: 45%; }

/* ---------- model settings modal ---------- */
#model-settings-modal {
    align: center middle;
}
#ms-band { width: 100; max-width: 92%; }
#model-settings-box {
    width: 1fr; height: auto;
    background: $surface; padding: 1 2;
}
.ms-title { margin-bottom: 1; }
.ms-row { height: auto; }
.ms-field { width: 1fr; height: auto; margin-right: 2; }
.ms-field:last-child { margin-right: 0; }
#ms-buttons { height: auto; align-horizontal: right; padding-top: 1; }

/* ---------- settings ---------- */
#settings-body { padding: 0 2 1 2; align-horizontal: center; }
.st-section { height: auto; width: 100%; max-width: 110; background: $primary 25%; padding: 1 2; margin: 0 0 1 0; }
.st-title { color: $accent; text-style: bold; }
.st-desc { color: $text-muted; }
.st-label { color: $text-muted; padding-top: 1; }
.st-row { height: auto; }
.st-field { width: 1fr; height: auto; margin-right: 2; }
.st-field:last-child { margin-right: 0; }

/* ---------- wizard ---------- */
#wizard-body { height: 1fr; padding: 1 2; }
#wizard-buttons { height: auto; align-horizontal: right; padding: 1 2; }
#wizard-progress { height: 1; color: $success; }

/* ---------- help ---------- */
HelpMarkdown { padding: 1 3; }

/* ---------- memory ---------- */
#soul-area { height: 1fr; width: 1fr; background: $surface; }
#memory-buttons { height: auto; }
#recent-memory { height: 8; color: $text-muted; background: $primary 25%; padding: 1 2; }

/* misc */
Button { margin: 0 1; }
OptionList { background: $surface; }
CommandPalette { padding: 1; background: $primary 60%; }
CommandPalette > * { background: $surface; }
Input { margin: 0 1; border: none; }
Input:focus { border: none; }

/* ---------- slash command menu ---------- */
#slash-band { display: none; margin: 0 2; }
#slash-menu {
    height: auto;
    max-height: 10;
    background: $panel;
}
/* Textual's default blockquote bar is `border-left: outer` (half-block ▕ at
   50% alpha) — renders as a broken dashed line with gaps in many fonts.
   Solid cyan: continuous │ (proven continuous in the user's terminal). */
MarkdownBlockQuote > BlockQuote { border-left: solid #00e5ff; }
/* The seal line under the thinking block: solid box-drawing chars (they
   tile seamlessly); the old `hkey` style painted background cells. */
Collapsible { border-top: solid $primary 40%; }
.msg-file { padding: 0 0 0 2; }
.msg-file-live { padding: 0 2 1 2; }

/* ---------- backend screen cards ---------- */
.backend-card { height: auto; padding: 0 1 1 1; }
.card-buttons { height: auto; }

/* ---------- switches: always legible on/off ---------- */
Switch { background: $primary 45%; padding: 0 1; margin-right: 1; border: none; }
